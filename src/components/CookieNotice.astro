---
// One-time notice about browser storage. The site sets no tracking or advertising cookies; "Decline" switches off
// the optional storage (checklist ticks, assistant history). The choice is remembered and can be changed on the cookie page.
import { type Lang } from '../i18n/content';
import { href } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = lang === 'fr'
  ? { title: 'Cookies et confidentialité', text: 'Ce site n’utilise ni publicité ni suivi. Avec votre accord, il garde dans votre navigateur votre progression dans la liste des documents et la conversation avec l’assistant. Si vous refusez, le site fonctionne normalement sans rien conserver.', cookies: 'Politique relative aux cookies', data: 'Protection des données', ok: 'J’accepte', no: 'Refuser' }
  : { title: 'Cookies and privacy', text: 'This website uses no advertising or tracking. With your agreement, it keeps your checklist progress and your conversation with the assistant in your browser. If you decline, the site works normally and keeps nothing.', cookies: 'Cookie policy', data: 'Data protection', ok: 'Accept', no: 'Decline' };
---
<div class="consent-bar" role="region" aria-label={L.title} data-consent-bar hidden>
  <div class="consent-bar-txt">
    <p class="consent-bar-h">{L.title}</p>
    <p>{L.text}</p>
    <p class="consent-bar-links"><a href={href(lang, 'cookies')}>{L.cookies}</a><a href={href(lang, 'privacy')}>{L.data}</a></p>
  </div>
  <div class="consent-bar-btns"><button type="button" class="btn btn-teal" data-consent="accepted">{L.ok}</button><button type="button" class="btn btn-ghost" data-consent="declined">{L.no}</button></div>
</div>
<script is:inline>
(() => {
  const KEY = 'nexora-consent';
  const bar = document.querySelector('[data-consent-bar]');
  if (!bar) return;
  const read = () => { try { return localStorage.getItem(KEY) || sessionStorage.getItem(KEY); } catch { return null; } };
  const write = (v) => { try { localStorage.setItem(KEY, v); } catch { try { sessionStorage.setItem(KEY, v); } catch { /* no storage */ } } };
  // Declining removes what the site already kept: checklist ticks and assistant history.
  const forget = () => { try { [localStorage, sessionStorage].forEach((st) => Object.keys(st).filter((k) => /^nexora-(ck|bot)-/.test(k)).forEach((k) => st.removeItem(k))); } catch { /* no storage */ } };
  const open = () => { bar.hidden = false; bar.classList.remove('consent-bye'); document.documentElement.classList.add('consent-open'); };
  const close = () => { bar.classList.add('consent-bye'); document.documentElement.classList.remove('consent-open'); setTimeout(() => { bar.hidden = true; }, 350); };
  if (!read()) open();
  bar.querySelectorAll('[data-consent]').forEach((b) => b.addEventListener('click', () => {
    const choice = b.dataset.consent;
    if (choice === 'declined') forget();
    write(JSON.stringify({ v: 2, choice, at: new Date().toISOString() }));
    close();
  }));
  // "Change my choice" on the cookie policy page shows the notice again.
  document.querySelectorAll('[data-consent-reset]').forEach((b) => b.addEventListener('click', () => { try { localStorage.removeItem(KEY); sessionStorage.removeItem(KEY); } catch { /* no storage */ } open(); bar.querySelector('button').focus(); }));
})();
</script>
