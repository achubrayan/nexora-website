---
// On-site help assistant: answers common questions from the site's own content, then hands over to WhatsApp.
// No external service and no data leaves the browser until the visitor chooses WhatsApp.
import type { Lang } from '../i18n/content';
import { assistantData } from '../lib/assistant';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const data = assistantData(Astro.props.lang);
const ui = data.ui;
---
<div class="nx-bot" data-bot>
  <button class="nx-bot-launch" type="button" aria-expanded="false" aria-controls="nx-bot-panel" data-bot-open>
    <span class="nx-bot-launch-ico" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4V5Z" /><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01" stroke-width="2.6" /></svg></span>
    <span class="nx-bot-launch-txt">{ui.open}</span>
  </button>
  <section class="nx-bot-panel" id="nx-bot-panel" role="dialog" aria-modal="false" aria-label={ui.title} hidden data-bot-panel>
    <header class="nx-bot-head">
      <span class="nx-bot-avatar" aria-hidden="true"><img src="/img/logo-white.png" alt="" width="26" height="19" /></span>
      <span class="nx-bot-id"><b>{ui.title}</b><small><i></i>{ui.status}</small></span>
      <button type="button" class="nx-bot-icon" data-bot-restart aria-label={ui.restart} title={ui.restart}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4" /></svg></button>
      <button type="button" class="nx-bot-icon" data-bot-close aria-label={ui.close} title={ui.close}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
    </header>
    <div class="nx-bot-log" role="log" aria-live="polite" data-bot-log></div>
    <form class="nx-bot-form" data-bot-form>
      <label class="sr-only" for={`nx-bot-q-${data.lang}`}>{ui.placeholder}</label>
      <input id={`nx-bot-q-${data.lang}`} name="q" autocomplete="off" maxlength="300" placeholder={ui.placeholder} />
      <button type="submit" aria-label={ui.send}><Icon name="arrow" size={18} /></button>
    </form>
    <p class="nx-bot-note">{ui.note}</p>
  </section>
  <script type="application/json" data-bot-data set:html={JSON.stringify(data)} />
</div>
<script>
  type Act = { label: string; href?: string; wa?: boolean; ask?: string };
  type Intent = { id: string; kw: string[]; a: string; acts: Act[]; chips: string[] };
  type Msg = { who: 'bot' | 'me'; text: string; acts?: Act[]; chips?: string[]; q?: string };

  const root = document.querySelector<HTMLElement>('[data-bot]');
  if (root) {
    const D = JSON.parse(root.querySelector('[data-bot-data]')!.textContent!);
    const panel = root.querySelector<HTMLElement>('[data-bot-panel]')!, log = root.querySelector<HTMLElement>('[data-bot-log]')!;
    const launch = root.querySelector<HTMLButtonElement>('[data-bot-open]')!, form = root.querySelector<HTMLFormElement>('[data-bot-form]')!;
    const input = form.querySelector('input')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const KEY = `nexora-bot-${D.lang}`;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9%]+/g, ' ').trim();
    const load = (): Msg[] => { try { return JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch { return []; } };
    // Keep the conversation for the tab only if the visitor did not decline optional storage.
    const declined = () => { try { return JSON.parse(localStorage.getItem('nexora-consent') || sessionStorage.getItem('nexora-consent') || '{}').choice === 'declined'; } catch { return false; } };
    const save = (m: Msg[]) => { if (declined()) return; try { sessionStorage.setItem(KEY, JSON.stringify(m.slice(-30))); } catch { /* storage unavailable */ } };
    let msgs: Msg[] = load();

    const wa = (q?: string) => `${D.whatsapp}?text=${encodeURIComponent(D.waHello + (q ? q.charAt(0).toLowerCase() + q.slice(1) : ''))}`;

    // Score every intent by the keywords found in the question. A destination and a cross-cutting topic
    // (price, timing, guarantee…) can both apply: "how much is a visa for Canada" gets both answers.
    const CROSS = ['price', 'time', 'guarantee', 'refusal', 'passport', 'desk'];
    const answer = (q: string): Msg => {
      const t = ` ${norm(q)} `;
      let country: Intent | null = null, topic: Intent | null = null, cs = 0, ts = 0;
      for (const it of D.intents as Intent[]) {
        let s = 0;
        for (const k of it.kw) if (t.includes(` ${k} `) || (k.length >= 5 && t.includes(` ${k}`))) s += k.split(' ').length * 3 + k.length / 10;
        if (!s) continue;
        if (it.id.startsWith('c-')) { if (s > cs) { cs = s; country = it; } } else if (s > ts) { ts = s; topic = it; }
      }
      if (!country && !topic) return { who: 'bot', text: D.ui.fallback, acts: [{ label: D.ui.handoff, wa: true }], chips: D.start, q };
      if (!country) return { who: 'bot', text: topic!.a, acts: topic!.acts, chips: topic!.chips, q };
      // A destination plus a visa type ("study in Canada") points the checklist at that exact list.
      const v = (Object.keys(D.visaKw) as string[]).find((k) => D.visaKw[k].some((w: string) => t.includes(` ${w}`)));
      const acts = v ? [{ label: country.acts[0].label, href: `${D.checklist}?dest=${country.id.slice(2)}&visa=${v}` }, ...country.acts.slice(1)] : country.acts;
      if (topic && CROSS.includes(topic.id)) return { who: 'bot', text: `${topic.a}\n\n${country.a}`, acts: [...acts, ...topic.acts.filter((a) => !acts.some((b) => b.label === a.label))], chips: topic.chips, q };
      return { who: 'bot', text: country.a, acts, chips: country.chips, q };
    };

    const el = (tag: string, cls?: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
    const render = (m: Msg, last: boolean) => {
      const row = el('div', `nx-msg nx-from-${m.who}`);
      row.append(el('p', 'nx-bubble', m.text));
      if (m.acts?.length) {
        const acts = el('div', 'nx-acts');
        m.acts.forEach((a) => {
          const link = el('a', a.wa ? 'nx-act nx-act-wa' : 'nx-act', a.label) as HTMLAnchorElement;
          link.href = a.wa ? wa(m.q) : a.href!;
          if (a.wa) { link.target = '_blank'; link.rel = 'noopener'; }
          acts.append(link);
        });
        row.append(acts);
      }
      if (last && m.chips?.length) {
        const chips = el('div', 'nx-chips');
        m.chips.forEach((id) => { if (!D.chips[id]) return; const b = el('button', 'nx-chip', D.chips[id]) as HTMLButtonElement; b.type = 'button'; b.onclick = () => ask(D.chips[id]); chips.append(b); });
        row.append(chips);
      }
      log.append(row);
    };
    const paint = () => { log.textContent = ''; msgs.forEach((m, i) => render(m, i === msgs.length - 1)); log.scrollTop = log.scrollHeight; };

    const ask = (q: string) => {
      q = q.trim(); if (!q) return;
      log.querySelectorAll('.nx-chips').forEach((c) => c.remove());
      msgs.push({ who: 'me', text: q }); render(msgs[msgs.length - 1], false);
      const typing = el('div', 'nx-msg nx-from-bot nx-typing'); typing.append(el('p', 'nx-bubble', '')); typing.firstChild!.append(el('i'), el('i'), el('i'));
      log.append(typing); log.scrollTop = log.scrollHeight;
      setTimeout(() => { typing.remove(); const m = answer(q); msgs.push(m); save(msgs); render(m, true); log.scrollTop = log.scrollHeight; }, reduce ? 0 : 550 + Math.min(700, q.length * 12));
    };

    const greet = () => { msgs = [{ who: 'bot', text: D.ui.hello, chips: D.start }]; save(msgs); paint(); };
    const open = (on: boolean) => {
      panel.hidden = !on; launch.setAttribute('aria-expanded', String(on)); root.classList.toggle('is-open', on);
      if (on) { if (!msgs.length) greet(); else paint(); setTimeout(() => input.focus(), 50); } else launch.focus();
    };
    launch.addEventListener('click', () => open(panel.hidden));
    root.querySelector('[data-bot-close]')!.addEventListener('click', () => open(false));
    root.querySelector('[data-bot-restart]')!.addEventListener('click', greet);
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
    form.addEventListener('submit', (e) => { e.preventDefault(); const q = input.value; input.value = ''; ask(q); });
  }
</script>
