---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Assistant from '../components/Assistant.astro';
import CookieNotice from '../components/CookieNotice.astro';
import type { Lang } from '../i18n/content';
import type { PageKey, Paths } from '../i18n/routes';
interface Props { lang: Lang; page: PageKey; title: string; description: string; preload?: string; paths?: Paths; og?: string; schema?: object[] }
const { lang, page, title, description, preload, paths, og, schema } = Astro.props;
---
<Base lang={lang} page={page} title={title} description={description} preload={preload} paths={paths} og={og} schema={schema}>
  <Header lang={lang} page={page} paths={paths} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />
  <WhatsAppFab lang={lang} />
  <Assistant lang={lang} />
  <CookieNotice lang={lang} />
  <script is:inline>
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const header = document.querySelector('[data-header]');
    const onScroll = () => header.classList.toggle('scrolled', scrollY > 24);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // Count numbers up from zero, keeping their prefix and suffix.
    const count = (el) => {
      const n = +el.dataset.count, pre = el.dataset.pre || '', suf = el.dataset.suf || '';
      if (reduce) { el.textContent = pre + n + suf; return; }
      const t0 = performance.now(), dur = 1400;
      const step = (now) => { const p = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        el.textContent = pre + Math.round(n * e) + suf; if (p < 1) requestAnimationFrame(step); };
      el.textContent = pre + '0' + suf; requestAnimationFrame(step);
    };

    // Reveal blocks and play visuals when they enter the viewport (everything stays visible without JS).
    const play = (el) => { el.classList.add('in'); el.querySelectorAll('[data-count]').forEach((c) => setTimeout(() => count(c), reduce ? 0 : 500)); };
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { play(e.target); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('.reveal, [data-viz], [data-counts]').forEach((el) => reduce ? play(el) : io.observe(el));
    if (reduce) document.querySelectorAll('svg.viz').forEach((s) => s.pauseAnimations && s.pauseAnimations());

    // Statement words and step progress follow the scroll position.
    const st = document.querySelector('[data-words]'); const ws = st ? [...st.children] : [];
    const lines = [...document.querySelectorAll('[data-steps]')];
    const clamp = (v) => Math.min(1, Math.max(0, v));
    const tick = () => {
      if (st) { const r = st.getBoundingClientRect(); const p = reduce ? 1 : clamp((innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35));
        const n = Math.round(p * ws.length); ws.forEach((w, i) => w.classList.toggle('on', i < n)); }
      lines.forEach((el) => { const r = el.getBoundingClientRect(); const p = reduce ? 1 : clamp((innerHeight * 0.8 - r.top) / (r.height + innerHeight * 0.2)); el.style.setProperty('--p', p.toFixed(3)); });
    };
    addEventListener('scroll', () => requestAnimationFrame(tick), { passive: true }); tick();

    // Tabs.
    document.querySelectorAll('[data-tabs]').forEach((box) => {
      const tabs = [...box.querySelectorAll('[role=tab]')]; const panels = [...box.querySelectorAll('[role=tabpanel]')];
      const select = (i, focus) => { tabs.forEach((t, j) => { t.setAttribute('aria-selected', j === i); t.tabIndex = j === i ? 0 : -1; }); panels.forEach((p, j) => p.dataset.active = j === i); if (focus) tabs[i].focus(); };
      tabs.forEach((t, i) => { t.addEventListener('click', () => select(i)); t.addEventListener('keydown', (e) => { const k = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (k) { e.preventDefault(); select((i + k + tabs.length) % tabs.length, true); } }); });
    });

    // Highlight a route on the mobility map when its destination is hovered or focused in the list.
    document.querySelectorAll('[data-dest-list]').forEach((list) => {
      const map = document.querySelector(list.dataset.destList); if (!map) return;
      const set = (id) => { map.classList.toggle('has-hl', !!id); map.querySelectorAll('[data-dest]').forEach((el) => el.classList.toggle('hl', el.dataset.dest === id)); };
      list.querySelectorAll('[data-dest]').forEach((row) => {
        row.addEventListener('mouseenter', () => set(row.dataset.dest)); row.addEventListener('focus', () => set(row.dataset.dest));
        row.addEventListener('mouseleave', () => set(null)); row.addEventListener('blur', () => set(null));
        row.addEventListener('click', () => { row.focus(); set(row.dataset.dest); });
      });
    });

    // Visa-type filters: show matching destinations and light up their routes.
    document.querySelectorAll('[data-filters]').forEach((bar) => {
      const list = document.querySelector(bar.dataset.filters); if (!list) return;
      const map = document.querySelector(list.dataset.destList);
      bar.querySelectorAll('[data-filter]').forEach((b) => b.addEventListener('click', () => {
        const f = b.dataset.filter; bar.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', x === b));
        const ids = new Set();
        list.querySelectorAll('[data-visas]').forEach((row) => { const on = f === 'all' || row.dataset.visas.split(' ').includes(f); row.hidden = !on; if (on) ids.add(row.dataset.dest); });
                if (map) { map.classList.toggle('has-hl', f !== 'all'); map.querySelectorAll('[data-dest]').forEach((el) => el.classList.toggle('hl', f !== 'all' && ids.has(el.dataset.dest))); }
      }));
    });

    // Thank-you notice after a form submission.
    if (/[?&]sent=1/.test(location.search)) document.querySelectorAll('[data-sent]').forEach((el) => el.hidden = false);

    document.querySelectorAll('.nav-mobile a').forEach((a) => a.addEventListener('click', () => a.closest('details').removeAttribute('open')));
  })();
  </script>
</Base>
